{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "coodevelopment-sala",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-01",
  "durable_objects": {
    "bindings": [{ "name": "Jam", "class_name": "Jam" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["Jam"] }],
  // Assina o token da sala (Story 2.5), o mesmo valor que está na Vercel. Na
  // primeira publicação vai por `wrangler deploy --secrets-file`.
  "secrets": { "required": ["SEGREDO_SALA"] },
  "observability": { "enabled": true }
}
