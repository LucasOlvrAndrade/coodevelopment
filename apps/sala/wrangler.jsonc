{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "coodevelopment-sala",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-01",
  "durable_objects": {
    "bindings": [{ "name": "Jam", "class_name": "Jam" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["Jam"] }],
  "observability": { "enabled": true }
}
